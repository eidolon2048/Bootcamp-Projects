{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Emotion Streamlit App",
      "type": "shell",
      "command": "/Users/roma/anaconda3/bin/conda",
      "args": [
        "run",
        "-n",
        "streamlit_environment",
        "streamlit",
        "run",
        "app.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Check Emotion App Environment",
      "type": "shell",
      "command": "/Users/roma/anaconda3/bin/conda",
      "args": [
        "run",
        "-n",
        "streamlit_environment",
        "python",
        "check_environment.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
